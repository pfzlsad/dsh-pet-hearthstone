+function detectHearthstoneProcess() {
+	return new Promise((resolveDetect) => {
+		const isWin = process.platform === "win32";
+		const command = isWin ? "tasklist" : "pgrep";
+		const args = isWin ? ["/NH", "/FO", "CSV"] : ["-i", "-f", "hearthstone"];
+		let child;
+		try {
+			child = spawn(command, args, { windowsHide: true });
+		} catch {
+			resolveDetect(false);
+			return;
+		}
+		let out = "";
+		let done = false;
+		let killTimer = null;
+		const finish = (value) => {
+			if (done) return;
