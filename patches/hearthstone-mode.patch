+  if (a > 0 || b > 0) return a >= b ? 1 : 2;
+  const counts = { 1: 0, 2: 0 };
+  for (const e of st.entities.values()) {
+    if (e.zone === "HAND" && e.cardId && (e.controller === 1 || e.controller === 2)) counts[e.controller] += 1;
+  }
